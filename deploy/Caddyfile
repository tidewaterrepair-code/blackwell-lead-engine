{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:8000 {
		flush_interval -1   # stream the live lead ticker (server-sent events) without buffering
	}
}

# www → bare domain (add a DNS A record for www too; until it exists Caddy just logs a retry)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

