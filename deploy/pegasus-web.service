# systemd unit for running without Docker (Postgres installed separately). Install:
#   sudo cp deploy/pegasus-*.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pegasus-web pegasus-worker
[Unit]
Description=Pegasus web app
After=network-online.target postgresql.service

[Service]
User=pegasus
WorkingDirectory=/opt/pegasus
EnvironmentFile=/opt/pegasus/.env
Environment=PEGASUS_ENV=production
ExecStartPre=/opt/pegasus/.venv/bin/pegasus db upgrade
ExecStart=/opt/pegasus/.venv/bin/pegasus serve --host 127.0.0.1 --port 8000 --workers 2
Restart=always

[Install]
WantedBy=multi-user.target
