# Copy to .env and fill in. Everything here is free.

# --- required
APP_PASSWORD=change-me                  # dashboard login
SECRET_KEY=replace-with-a-long-random-string   # e.g. output of: openssl rand -hex 32
PUBLIC_URL=https://leads.example.com     # used for links in emails/pushes
DOMAIN=leads.example.com                 # for Caddy HTTPS (DNS A record -> your VPS IP)

# --- your shop location (for distance scoring and the map). Right-click in Google Maps to copy.
BASE_LAT=36.7682
BASE_LNG=-76.2875

# --- schedule (server time, TZ below)
TZ=America/New_York
INGEST_HOURS=6,14         # pull new leads at 6:05 and 14:05
DIGEST_HOUR=7             # email digest at 7:30
LOOKBACK_DAYS=30          # how far back the very first import goes

# --- daily email digest (Gmail: turn on 2-step verification, then create an "App password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
DIGEST_MIN_SCORE=55

# --- instant phone alerts for hot leads via ntfy (free app for iOS/Android).
# Pick a hard-to-guess topic name and subscribe to it in the app.
NTFY_URL=
HOT_LEAD_SCORE=80

# --- homeowner-request inbox (see sources.yaml: email-requests)
IMAP_USER=
IMAP_PASSWORD=

# --- optional
# SOCRATA_APP_TOKEN=      # free token from data.norfolk.gov raises rate limits
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2:3b
# INSTALL_BROWSER=true    # build with Chromium for Accela portals (Chesapeake)
# GEOCODE=1
