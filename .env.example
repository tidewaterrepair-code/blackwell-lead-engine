# Pegasus configuration. Copy to .env and fill in. See docs/DEPLOY.md.
# Only the "required" block is needed to start; everything else switches features on.

# ---------------------------------------------------------------- required
DOMAIN=pegasusleads.com                    # DNS A record -> this VPS (Caddy gets HTTPS for it)
PUBLIC_URL=https://pegasusleads.com        # used in emails, links and the sitemap
SECRET_KEY=                                # openssl rand -hex 32  (the app refuses to start without it)
POSTGRES_PASSWORD=                         # openssl rand -hex 16
ADMIN_EMAILS=you@example.com               # these accounts get Mission Control (/app/admin)
TZ=America/New_York

# ---------------------------------------------------------------- email (sign-in links, Morning Drop, lifecycle)
# Without SMTP_HOST, emails are logged instead of sent. Setup: marketing/automation/email.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pegasus <hello@pegasusleads.com>

# ---------------------------------------------------------------- billing (Stripe). Setup: marketing/automation/stripe.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COUPON_FOUNDING=                    # 40% forever coupon for the first 100 accounts
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_TERRITORY_ADDON=
STRIPE_PRICE_EXCLUSIVE_ZIP=
STRIPE_PRICE_CREDITS_25=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_250=

# ---------------------------------------------------------------- AI (lead briefs, Source Scout, label fallback, post polish)
# Pay as you go: console.anthropic.com. Without a key, Pegasus uses templates (and Ollama if set).
ANTHROPIC_API_KEY=
AI_FAST_MODEL=claude-opus-5-5
AI_SMART_MODEL=claude-opus-5-5
SCOUT_AUTO_APPROVE=0.85                    # Source Scout auto-approves configs scoring at least this; 1.01 = always review
# OLLAMA_URL=http://ollama:11434           # free local fallback: docker compose --profile ai up -d
# OLLAMA_MODEL=llama3.2:3b

# ---------------------------------------------------------------- data providers (pay as you grow; resold as credits)
BATCHDATA_API_KEY=                         # skip trace + DNC flags
REGRID_TOKEN=                              # parcels, owners, vacancy
SOCRATA_APP_TOKEN=                         # free; raises open-data rate limits

# ---------------------------------------------------------------- schedule (server time, TZ above)
INGEST_HOURS=5,11,17                       # pull public data at these hours
DIGEST_HOUR=7                              # Morning Drop
LOOKBACK_DAYS=30                           # how far back a new source's first import goes
GEOCODE=1                                  # geocode addresses with free OpenStreetMap Nominatim
GEOCODE_PER_RUN=500

# ---------------------------------------------------------------- push alerts and analytics
NTFY_BASE_URL=https://ntfy.sh              # or your own ntfy server
# UMAMI_SRC=https://stats.pegasusleads.com/script.js
# UMAMI_WEBSITE_ID=

# ---------------------------------------------------------------- homeowner-request inbox (sources.yaml: email-requests)
IMAP_USER=
IMAP_PASSWORD=

# ---------------------------------------------------------------- server
WEB_WORKERS=2
# INSTALL_BROWSER=true                     # build with Chromium (Accela portals, banner rendering)
# BACKUP_KEEP=14
